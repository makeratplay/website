# Copy to scripts/meta-publisher/.env and fill in values from
# https://developers.facebook.com/apps/

META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret

# Facebook Page to post as (id or vanity name). Default looks up "makeratplay".
META_PAGE_ID=makeratplay

# Site origin used to turn relative article/image paths into absolute URLs
SITE_BASE_URL=https://makeratplay.com

# Optional hashtags appended to every caption (space-separated, with or without #)
META_HASHTAGS=#MakerAtPlay #Making

# Graph API version
META_GRAPH_VERSION=v21.0
