# Copy to scripts/tumblr-publisher/.env and fill in values from
# https://www.tumblr.com/oauth/apps
#
# Register redirect URI: http://127.0.0.1:8765/callback

TUMBLR_CLIENT_ID=your_oauth_consumer_key
TUMBLR_CLIENT_SECRET=your_oauth_consumer_secret
TUMBLR_REDIRECT_URI=http://127.0.0.1:8765/callback
TUMBLR_BLOG=mlhblog.tumblr.com

# Default tags (comma-separated)
TUMBLR_TAGS=marching band,props,2026,maker at play

# Path to project HTML (relative to repo root)
PROJECT_HTML=projects/64/index.html
PROJECT_DIR=projects/64

# Content source attribution on Tumblr posts
SOURCE_URL=https://makeratplay.com/projects/64/index.html
